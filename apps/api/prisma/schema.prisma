generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  name            String?
  emailVerified   Boolean              @default(false)
  image           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  businessId      String?
  isActive        Boolean              @default(true)
  role            UserRole             @default(CASHIER)
  accounts        Account[]
  drawerMovements CashDrawerMovement[]
  notifications   Notification[]
  posSessions     PosSession[]
  sales           Sale[]
  sessions        Session[]
  stockMovements  StockMovement[]
  payrollConfig   StaffPayroll?
  payrollRecords  PayrollRecord[]
  expensesRecorded Expense[]           @relation("ExpensesRecorded")
  business        Business?            @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Business {
  id            String         @id @default(cuid())
  name          String
  logo          String?
  address       String?
  phone         String?
  email         String?
  currency      String         @default("NGN")
  taxRate       Decimal        @default(0) @db.Decimal(10, 2)
  logoUrl       String?
  taxIdNumber   String?        // FIRS Tax Identification Number (TIN)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  auditLogs     AuditLog[]
  categories    Category[]
  customers     Customer[]
  notifications Notification[]
  posSessions   PosSession[]
  products      Product[]
  sales         Sale[]
  staffInvites  StaffInvite[]
  suppliers     Supplier[]
  expenses      Expense[]
  users         User[]

  @@map("business")
}

model Category {
  id          String     @id @default(cuid())
  name        String
  description String?
  businessId  String
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent      Category?  @relation("subcategories", fields: [parentId], references: [id])
  children    Category[] @relation("subcategories")
  products    Product[]

  @@unique([name, businessId])
  @@index([businessId])
  @@index([parentId])
  @@index([name])
  @@map("category")
}

model Product {
  id                  String              @id @default(cuid())
  name                String
  description         String?
  sku                 String
  barcode             String?             @unique
  businessId          String
  categoryId          String?
  unit                String              @default("piece")
  buyingPrice         Decimal             @default(0) @db.Decimal(10, 2)
  sellingPrice        Decimal             @default(0) @db.Decimal(10, 2)
  images              String[]            @default([])
  lowStockThreshold   Int                 @default(10)
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  expiryDate          DateTime?
  preferredSupplierId String?
  business            Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category            Category?           @relation(fields: [categoryId], references: [id])
  preferredSupplier   Supplier?           @relation(fields: [preferredSupplierId], references: [id])
  variants            ProductVariant[]
  purchaseItems       PurchaseOrderItem[]
  saleItems           SaleItem[]
  stockMovements      StockMovement[]
  stockRecord         StockRecord?

  @@unique([sku, businessId])
  @@index([businessId])
  @@index([categoryId])
  @@index([sku])
  @@index([name])
  @@map("product")
}

model ProductVariant {
  id             String          @id @default(cuid())
  productId      String
  name           String
  sku            String?
  price          Decimal?        @db.Decimal(10, 2)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems      SaleItem[]
  stockMovements StockMovement[]
  stockRecord    StockRecord?

  @@index([productId])
  @@map("product_variant")
}

model StockRecord {
  id        String          @id @default(cuid())
  productId String          @unique
  variantId String?         @unique
  quantity  Int             @default(0)
  updatedAt DateTime        @updatedAt
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("stock_record")
}

model StockMovement {
  id         String            @id @default(cuid())
  productId  String
  variantId  String?
  type       StockMovementType
  quantity   Int
  reason     String?
  cost       Decimal?          @db.Decimal(10, 2)
  userId     String
  supplierId String?
  createdAt  DateTime          @default(now())
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier   Supplier?         @relation(fields: [supplierId], references: [id])
  user       User              @relation(fields: [userId], references: [id])
  variant    ProductVariant?   @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([createdAt])
  @@map("stock_movement")
}

model Supplier {
  id             String            @id @default(cuid())
  name           String
  phone          String?
  email          String?
  address        String?
  businessId     String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  products       Product[]
  purchaseOrders PurchaseOrder[]
  stockMovements StockMovement[]
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payments       SupplierPayment[]

  @@index([businessId])
  @@map("supplier")
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  reference        String              @unique
  supplierId       String
  status           PurchaseOrderStatus @default(PENDING)
  expectedDelivery DateTime?
  notes            String?
  total            Decimal             @default(0) @db.Decimal(10, 2)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  items            PurchaseOrderItem[]

  @@index([supplierId])
  @@map("purchase_order")
}

model PurchaseOrderItem {
  id        String        @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  received  Int           @default(0)
  cost      Decimal       @db.Decimal(10, 2)
  createdAt DateTime      @default(now())
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("purchase_order_item")
}

model SupplierPayment {
  id         String   @id @default(cuid())
  supplierId String
  amount     Decimal  @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime @default(now())
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_payment")
}

model Customer {
  id            String       @id @default(cuid())
  name          String
  phone         String?
  email         String?
  businessId    String
  loyaltyPoints Int          @default(0)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  creditSales   CreditSale[]
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales         Sale[]

  @@index([businessId])
  @@map("customer")
}

model Sale {
  id           String      @id @default(cuid())
  reference    String      @unique
  businessId   String
  cashierId    String
  customerId   String?
  subtotal     Decimal     @db.Decimal(10, 2)
  discount     Decimal     @default(0) @db.Decimal(10, 2)
  discountType String?
  total        Decimal     @db.Decimal(10, 2)
  status       SaleStatus  @default(PENDING)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  posSessionId String?
  cuid         String?     @unique
  receiptUrl   String?
  tax          Decimal     @default(0) @db.Decimal(10, 2)
  creditSale   CreditSale?
  payments     Payment[]
  receipt      Receipt?
  business     Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cashier      User        @relation(fields: [cashierId], references: [id])
  customer     Customer?   @relation(fields: [customerId], references: [id])
  posSession   PosSession? @relation(fields: [posSessionId], references: [id])
  items        SaleItem[]

  @@index([businessId, createdAt])
  @@index([cashierId])
  @@index([customerId])
  @@index([cuid])
  @@map("sale")
}

model SaleItem {
  id        String          @id @default(cuid())
  saleId    String
  productId String
  variantId String?
  quantity  Int
  unitPrice Decimal         @db.Decimal(10, 2)
  total     Decimal         @db.Decimal(10, 2)
  returned  Int             @default(0)
  createdAt DateTime        @default(now())
  product   Product         @relation(fields: [productId], references: [id])
  sale      Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_item")
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  reference String?
  confirmed Boolean       @default(false)
  createdAt DateTime      @default(now())
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("payment")
}

model CreditSale {
  id          String            @id @default(cuid())
  saleId      String            @unique
  customerId  String
  totalAmount Decimal           @db.Decimal(10, 2)
  amountPaid  Decimal           @default(0) @db.Decimal(10, 2)
  balance     Decimal           @db.Decimal(10, 2)
  dueDate     DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  repayments  CreditRepayment[]
  customer    Customer          @relation(fields: [customerId], references: [id])
  sale        Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("credit_sale")
}

model CreditRepayment {
  id           String     @id @default(cuid())
  creditSaleId String
  amount       Decimal    @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime   @default(now())
  creditSale   CreditSale @relation(fields: [creditSaleId], references: [id], onDelete: Cascade)

  @@index([creditSaleId])
  @@map("credit_repayment")
}

model PosSession {
  id           String               @id @default(cuid())
  businessId   String
  userId       String
  status       SessionStatus        @default(OPEN)
  startingCash Decimal              @default(0) @db.Decimal(10, 2)
  expectedCash Decimal              @default(0) @db.Decimal(10, 2)
  actualCash   Decimal?             @db.Decimal(10, 2)
  variance     Decimal?             @db.Decimal(10, 2)
  notes        String?
  openedAt     DateTime             @default(now())
  closedAt     DateTime?
  movements    CashDrawerMovement[]
  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id])
  sales        Sale[]

  @@index([businessId])
  @@index([userId])
  @@index([status])
  @@map("pos_session")
}

model CashDrawerMovement {
  id        String             @id @default(cuid())
  sessionId String
  userId    String
  type      DrawerMovementType
  amount    Decimal            @db.Decimal(10, 2)
  reason    String
  createdAt DateTime           @default(now())
  session   PosSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@map("cash_drawer_movement")
}

model Receipt {
  id        String    @id @default(cuid())
  saleId    String    @unique
  pdfUrl    String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  sale      Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("receipt")
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  businessId String
  type       NotificationType
  message    String
  read       Boolean          @default(false)
  metadata   Json?
  createdAt  DateTime         @default(now())
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([businessId])
  @@map("notification")
}

model StaffInvite {
  id         String            @id @default(cuid())
  email      String
  role       UserRole          @default(CASHIER)
  token      String            @unique
  businessId String
  status     StaffInviteStatus @default(PENDING)
  expiresAt  DateTime
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([token])
  @@index([email])
  @@map("staff_invite")
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityId   String
  actorId    String
  businessId String
  metadata   Json?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([actorId])
  @@index([action])
  @@map("audit_log")
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER
}

enum StaffInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum PurchaseOrderStatus {
  PENDING
  PARTIAL
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  PENDING
  COMPLETED
  PARTIALLY_RETURNED
  RETURNED
  VOID
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  PAYSTACK
  CREDIT
}

enum DrawerMovementType {
  PAID_IN
  PAID_OUT
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  PAYMENT_CONFIRMED
  PURCHASE_ORDER_RECEIVED
  CREDIT_DUE
  STOCK_DISCREPANCY
}

// Payroll

model StaffPayroll {
  id             String   @id @default(cuid())
  userId         String   @unique
  businessId     String
  baseSalary     Decimal  @default(0) @db.Decimal(10, 2)
  commissionRate Decimal  @default(0) @db.Decimal(5, 4)
  payFrequency   String   @default("MONTHLY")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("staff_payroll")
}

model PayrollRecord {
  id               String    @id @default(cuid())
  userId           String
  businessId       String
  periodStart      DateTime
  periodEnd        DateTime
  baseSalary       Decimal   @db.Decimal(10, 2)
  commissionEarned Decimal   @default(0) @db.Decimal(10, 2)
  totalSales       Decimal   @default(0) @db.Decimal(10, 2)
  totalPay         Decimal   @db.Decimal(10, 2)
  status           String    @default("DRAFT")
  paidAt           DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([userId])
  @@map("payroll_record")
}

model Expense {
  id              String   @id @default(cuid())
  businessId      String
  branchId        String?
  category        String   // RENT, FUEL, UTILITIES, SALARY, MAINTENANCE, MARKETING, OTHER
  amount          Decimal  @db.Decimal(10, 2)
  date            DateTime
  description     String?
  receiptUrl      String?
  recordedById    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recordedBy      User     @relation("ExpensesRecorded", fields: [recordedById], references: [id])

  @@index([businessId])
  @@index([recordedById])
  @@index([date])
  @@map("expense")
}
